# Copy this file to ".env" for local dev, and set the same variables in
# Vercel → Project → Settings → Environment Variables. Never commit ".env".

# --- Supabase (shared RSVP storage) ---
# Leave BOTH blank to use browser-only (localStorage) storage instead.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Admin / collector passcode ---
# Passcode for the ?admin=1 view. Optional — defaults to the value in
# src/config.js if unset. On a static build this value is embedded in the client
# bundle, so treat it as a deterrent, not hard security.
VITE_ADMIN_PASSCODE=
